# ========================================================
# PlantCare AI - Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control!
# ========================================================

# --- Backend Application Settings ---
PROJECT_NAME="PlantCare AI"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- Database (Supabase / PostgreSQL) ---
# Default fallback to local SQLite for instant zero-dependency execution:
DATABASE_URL=sqlite+aiosqlite:///./plantcare.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Telegram Bot Configuration ---
# Create your bot using @BotFather on Telegram to obtain your token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_NOTIFICATION_COOLDOWN_MINUTES=60

# --- Hardware / ESP32 Ingestion Security ---
ESP32_API_SECRET_KEY=your_esp32_device_shared_secret_key

# --- Simulation Engine ---
SIMULATION_ENABLED=true
SIMULATION_UPDATE_INTERVAL_SECONDS=10

# --- Frontend Settings (Vite prefix required for client-side access) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="PlantCare AI"
